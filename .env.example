# Base URL of the Design House backend API (not wired up yet — the admin runs on demo data)
NEXT_PUBLIC_API_URL=http://localhost:5000

# SEO audit screens (optional): the website that is audited and the brand name used in titles / file names.
# They default to https://www.designhouse.co.in and "Design House India"; the backend reads SEO_AUDIT_ORIGIN / SEO_SITE_NAME.
# NEXT_PUBLIC_SEO_AUDIT_ORIGIN=https://www.designhouse.co.in
# NEXT_PUBLIC_SEO_SITE_NAME=Design House India
# Google PageSpeed Insights key for the admin's /pagespeed route (a quota-free key avoids 429s)
# PSI_API_KEY=
